# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
game/.utmp/
game/[Ll]ibrary/
game/[Tt]emp/
game/[Oo]bj/
game/[Bb]uild/
game/[Bb]uilds/
game/[Ll]ogs/
game/[Uu]ser[Ss]ettings/
game/*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
game/*.blend1
game/*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
game/[Mm]emoryCaptures/

# Recordings can get excessive in size
game/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
game/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
game/*.DotSettings.user

# Visual Studio cache directory
game/.vs/

# Gradle cache directory
game/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
game/.consulo/
game/*.csproj
game/*.unityproj
game/*.sln
game/*.suo
game/*.tmp
game/*.user
game/*.userprefs
game/*.pidb
game/*.booproj
game/*.svd
game/*.pdb
game/*.mdb
game/*.opendb
game/*.VC.db

# Unity3D generated meta files
game/*.pidb.meta
game/*.pdb.meta
game/*.mdb.meta

# Unity3D generated file on crash reports
game/sysinfo.txt

# Mono auto generated files
game/mono_crash.*

# Builds
game/*.apk
game/*.aab
game/*.unitypackage
game/*.unitypackage.meta
game/*.app

# Crashlytics generated file
game/crashlytics-build.properties

# TestRunner generated files
game/InitTestScene*.unity*

# Addressables default ignores, before user customizations
game/ServerData
game/[Aa]ssets/StreamingAssets/aa*
game/[Aa]ssets/AddressableAssetsData/link.xml*
game/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
game/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
game/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
game/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

game/Assets/Abandoned_Psychiatric_Hospitals
game/Assets/Abandoned_Psychiatric_Hospitals.meta

game/Assets/Abandoned_Asylum
game/Assets/Abandoned_Asylum.meta

mlModels
audio/newMLmodel
audio/giggles/giggleProject.aup3

game/Assets/Abandoned_Asylum



/mlModel2
